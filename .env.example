# Only the Discord token is required here - everything else is configured via Discord!

# Discord Bot Token (REQUIRED)
# Get this frm https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: configure servers directly by environment instead of setup wizard.
# Provider per server: crcon (default) or rcon
# SERVER_PROVIDER=rcon
#
# CRCON mode:
# CRCON_API_URL=
# CRCON_API_TOKEN=
#
# RCON mode:
# RCON_HOST=
# RCON_PORT=27015
# RCON_PASSWORD=
# RCON_POLL_INTERVAL_MS=5000
#
# Optional channel + cooldown:
# MAP_VOTE_CHANNEL_ID=
# EXCLUDE_PLAYED_MAP_FOR_XVOTES=3
