# Only the Discord token is required here - everything else can be configured via Discord.

# Discord Bot Token (REQUIRED)
# Get this frm https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional transport defaults for Server 1
# TRANSPORT_MODE values:
# - crcon-api
# - direct-rcon
# - crcon-api-with-rcon-fallback
TRANSPORT_MODE=crcon-api
CRCON_API_URL=
CRCON_API_TOKEN=
HLL_RCON_HOST=
HLL_RCON_PORT=
HLL_RCON_PASSWORD=

# Optional per-server overrides use _2 / _3 / _4 suffixes, for example:
# TRANSPORT_MODE_2=crcon-api-with-rcon-fallback
# HLL_RCON_HOST_2=
# HLL_RCON_PORT_2=
# HLL_RCON_PASSWORD_2=
